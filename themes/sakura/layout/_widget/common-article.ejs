<link rel="stylesheet" type="text/css" href="<%- url_for('/css/sharejs.css') %>">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tocbot/4.4.2/tocbot.css">
<%
  // 文章页作者信息：banner 作者行与底部作者卡片共用
  // 文章 front-matter 没写 author / avatar / authorLink / authorAbout 时
  // 会渲染成空链接 + 裂图 + 只有铅笔图标，这里统一回退到站点配置
  var _author = post.author || config.author || theme.siteName || 'Sky';
  var _authorLink = post.authorLink || url_for('/about/');
  var _av = post.avatar || theme.avatar || '';
  var _avSrc = /^https?:\/\//.test(_av) || _av.indexOf('//') === 0
    ? _av
    : (_av.indexOf('/') === 0 ? url_for(_av) : url_for((theme.cdn || '') + _av));
  var _about = post.authorAbout || '用文字记录技术与生活，欢迎交流。';
%>
<div class="pattern-center-blank"></div>
<% if (post.photos && post.photos.length){ %>
  <div class="pattern-center single-center">
    <!-- 有配图默认渲染第一张 -->
    <div class="pattern-attachment-img lazyload" style="background-image: url(<%= url_for(post.photos[0]) %>);" src="<%- theme.lazyloadImg%>" data-src="<%= url_for(post.photos[0]) %>">
    </div>
    <header class="pattern-header single-header">
      <h1 class="entry-title">
      <%- post.title %></h1>
      <p class="entry-census">
        <span>
          <a href="<%- _authorLink %>">
            <img src="<%- _avSrc %>" alt="<%- _author %>">
          </a>
        </span>
        <span>
          <a href="<%- _authorLink %>"><%- _author %></a>
        </span>
        <span class="bull">
        ·</span>
        <%= date(post.date, 'YYYY-M-D') %><span class="bull">
        ·</span>
      <span id="busuanzi_value_page_pv"></span>次阅读</p>
    </header>
  </div>
<% } %>
<div id="content" class="site-content">
  <div id="primary" class="content-area">
    <main id="main" class="site-main" role="main">
      <article id="post-1" class="post-1 post type-post status-publish format-standard has-post-thumbnail hentry category-uncategorized">
        <div class="toc"></div>
        <!--<div class="toc-entry-content"><!-- 套嵌目录使用（主要为了支援评论）-->
        <% if (!post.photos[0]){ %>
          <header class="entry-header">
            <h1 class="entry-title"><%- post.title %></h1>
            <p class="entry-census"><%- _author %>&nbsp;·&nbsp;<%= date(post.date, 'YYYY-M-D') %>&nbsp;·&nbsp;<span id="busuanzi_value_page_pv"></span>次阅读</p>

            <hr>
          </header>
        <% } %>
        <div class="entry-content">
          <%- post.content %>
        </div>
        <!-- .entry-content -->
        <div class="single-reward">
          <div class="reward-open">赏
            <div class="reward-main">
              <ul class="reward-row">
                <li class="alipay-code"><img src="<%- /^https?:\/\//.test(theme.donate.alipay) ? theme.donate.alipay : url_for(theme.donate.alipay) %>"></li>
                <li class="wechat-code"><img src="<%- /^https?:\/\//.test(theme.donate.wechat) ? theme.donate.wechat : url_for(theme.donate.wechat) %>"></li>
              </ul>
            </div>
          </div>
        </div>
        <div style="text-align:center; width: 100%" class="social-share share-mobile" data-disabled="diandian, tencent"></div>
        <footer class="post-footer">
          <div class="post-tags">
          </div>
          <div class="post-share">
            <div class="social-share sharehidden share-component"></div>
            <i class="iconfont show-share icon-forward"></i>
          </div>
        </footer><!-- .entry-footer -->
      </article>
      <!-- #post-## -->
      <div class="toc" style="background: none;"></div>
      <section class="post-squares nextprev">
        <% if (post.prev){ %>
          <% if (post.next) { %>
            <div class="post-nepre half previous">
          <% } else { %>
            <div class="post-nepre full previous">
          <% } %>
            <a href="<%- url_for(post.prev.path) %>" rel="prev">
              <div class="background">
                <img class="lazyload" src="<%- theme.lazyloadImg%>" data-src="<%- url_for(post.prev.photos[0])%>" style="width: 100%; height: 100%; object-fit: cover; pointer-events: none;" onerror="imgError(this,3)">
              </div>
              <span class="label">
              Previous Post</span>
              <div class="info">
                <h3>
                <%= post.prev.title%></h3>
                <hr>
              </div>
            </a>
          </div>
        <% } %>
        <% if (post.next){ %>
          <% if (post.prev) { %>
            <div class="post-nepre half next">
          <% } else { %>
            <div class="post-nepre full next">
          <% } %>
            <a href="<%- url_for(post.next.path) %>" rel="next">
              <div class="background">
                <img class="lazyload" src="<%- theme.lazyloadImg%>" data-src="<%- url_for(post.next.photos[0])%>" style="width: 100%; height: 100%; object-fit: cover; pointer-events: none;" onerror="imgError(this,3)">
              </div>
              <span class="label">
              Next Post</span>
              <div class="info">
                <h3>
                <%= post.next.title%></h3>
                <hr>
              </div>
            </a>
          </div>
        <% } %>
      </section>
      <%- partial('_partial/comment') %>
      <section class="author-profile">
        <div class="info" itemprop="author" itemscope="" itemtype="https://schema.org/Person">
          <a href="<%- _authorLink %>" class="profile gravatar"><img src="<%- _avSrc %>" itemprop="image" alt="<%- _author %>" height="70" width="70"></a>
          <div class="meta">
            <span class="title">Author</span>
            <h3 itemprop="name">
            <a href="<%- _authorLink %>" itemprop="url" rel="author"><%- _author %></a>
            </h3>
          </div>
        </div>
        <hr>
        <p><i class="iconfont icon-write"></i><%- _about %></p>
      </section>
    </main><!-- #main -->
  </div><!-- #primary -->
</div>

<% if (post.mathjax) { %>
  <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.4/latest.js?config=TeX-MML-AM_CHTML"></script>
  <script type="text/x-mathjax-config">
    MathJax.Hub.Config({tex2jax: {inlineMath: [['$','$'], ['\\(','\\)']]}});
  </script>
<% } %>
