<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.css">
<script src="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.js"></script>
<style>
  .aplayer .aplayer-lrc {
    height: 35px;
  }
  .aplayer .aplayer-lrc p{
    font-size: 16px;
    font-weight: 700;
    line-height: 18px !important;
  }
  .aplayer .aplayer-lrc p.aplayer-lrc-current{
    color: #FF1493;
  }
  .aplayer.aplayer-narrow .aplayer-body{
    left: -66px !important;
  }
  .aplayer.aplayer-fixed .aplayer-lrc {
    display: none;
  }
  .aplayer .aplayer-lrc.aplayer-lrc-hide {
      display:none !important;
  }
  .aplayer.aplayer-fixed .lrc-show {
    display: block;
    background: rgba(255, 255, 255, 0.8);
  }
</style>
<div id="aplayer" class="aplayer"></div>
<script>
  $(function(){
    var cfg = {
      server: '<%- theme.aplayer.server %>',
      type: '<%- theme.aplayer.type %>',
      id: '<%- theme.aplayer.id %>',
      fixed: <%- theme.aplayer.fixed === true ? 'true' : 'false' %>,
      autoplay: <%- theme.aplayer.autoplay === true ? 'true' : 'false' %>,
      loop: '<%- theme.aplayer.loop %>',
      order: '<%- theme.aplayer.order %>',
      preload: '<%- theme.aplayer.preload %>',
      volume: <%- theme.aplayer.volume || 0.7 %>,
      mutex: <%- theme.aplayer.mutex === true ? 'true' : 'false' %>
    };
    $.getJSON('https://api.i-meto.com/meting/api', {server: cfg.server, type: cfg.type, id: cfg.id})
      .done(function(songs){
        if (!songs || !songs.length) { console.log('music list empty'); return; }
        var ap = new APlayer({
          container: document.getElementById('aplayer'),
          fixed: cfg.fixed,
          autoplay: cfg.autoplay,
          loop: cfg.loop,
          order: cfg.order,
          preload: cfg.preload,
          volume: cfg.volume,
          mutex: cfg.mutex,
          audio: songs.map(function(s){
            return {name: s.title, artist: s.author, url: s.url, cover: s.pic, lrc: s.lrc};
          })
        });
        // 播放失败/坏链自动切下一首（网易云外链有部分 VIP/版权歌 404）
        ap.on('error', function(){
          try { ap.list.next(); } catch(e) {}
        });
        // 点击播放器切换歌词显示
        $('body').on('click', '.aplayer', function(){
          if ($('.aplayer-button').hasClass('aplayer-play')) {
            $('.aplayer-lrc').removeClass('lrc-show');
          } else {
            $('.aplayer-lrc').addClass('lrc-show');
          }
        });
      })
      .fail(function(){ console.log('music api unavailable'); });
  });
</script>