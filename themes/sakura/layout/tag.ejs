<%
  var isIndex = !page.tag;
  if (!isIndex) { var img = page.tag + '.img'; }
%>
<div class="pattern-center-blank"></div>
<div class="pattern-center ">
  <div class="pattern-attachment-img">
    <img <% if(!isIndex && __(img)){%>src="<%- theme.lazyloadImg%>" data-src="<%= __(img)%>"<%} else {%>src="<%- theme.lazyloadImg%>" data-src="https://view.moezx.cc/images/2017/12/03/writing.jpg"<%} %> class="lazyload" onerror="imgError(this,3)" style="width: 100%; height: 100%; object-fit: cover; pointer-events: none;">
  </div>
  <header class="pattern-header ">
    <h1 class="cat-title"><%= isIndex ? page.title : __(page.tag) %></h1>
    <% if (isIndex) { %>
      <span class="cat-des"><p><%= page.description || '' %></p></span>
    <% } %>
  </header>
</div>
<div id="content" class="site-content">
  <div id="primary" class="content-area">
    <main id="main" class="site-main" role="main">
      <% if (isIndex) { %>
        <!-- 标签索引：列出全部标签 + 文章数 -->
        <div class="tag-cloud" style="padding: 20px; display:flex; flex-wrap:wrap; gap:10px;">
          <% site.tags.sort('name').each(function(tag){ %>
            <a href="<%= url_for(tag.path) %>" style="display:inline-block; padding:6px 14px; border-radius:18px; background:rgba(0,0,0,.06); text-decoration:none; color:#333;">
              <span style="font-weight:600;"><%= tag.name %></span>
              <span style="margin-left:6px; color:#999; font-size:12px;"><%= tag.posts.length %></span>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <!-- 单标签页：该标签下的文章列表 -->
        <%- partial('_partial/category-archive', {pagination: 2, index: true}) %>
      <% } %>
      <div class="clearer">
      </div>
    </main>
    <% if (page.total > 1 && page.next_link){ %>
      <div id="pagination"><a href="<%- url_for(page.next_link) %>" class="">Previous</a></div>
    <% } %>
  </div>
</div>